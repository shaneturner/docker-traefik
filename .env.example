# Traefik Production Environment Variables
# Copy this file to .env and fill in your actual values

# Domain name for Traefik dashboard and services
# Default: localhost (for local development)
# Production: Set to your actual domain (e.g., example.com)
DOMAIN=example.com

# Cloudflare DNS API Token
# Required for Let's Encrypt DNS challenge in production mode
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Zone:DNS:Edit for the target zone(s)
CF_DNS_API_TOKEN=your_cloudflare_api_token_here

# User and Group IDs for running containers as non-root
# These prevent root-owned files in bind mounts
# The setup-production.sh script will auto-detect and set these values
# UID/GID: User running Traefik (typically your user account)
# DOCKER_GID: Docker group ID (needed for socket-proxy to access Docker socket)
# SOCKET_UID: Socket proxy user (65534 = nobody, recommended for isolation)
UID=1000
GID=1000
DOCKER_GID=999
SOCKET_UID=65534
